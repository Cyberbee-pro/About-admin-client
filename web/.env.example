
# ==============================================================================
# Environment Configuration Template for web/
# ==============================================================================
# Strict Zero-Fallback Policy: Every variable below is required. If any variable
# is missing or blank, the application will return a 500 Internal Configuration
# Error formatted as:
# {
#   "title": "Internal Configuration Error",
#   "status": 500,
#   "detail": "The required environment variable 'VARIABLE_NAME' is missing or not set.",
#   "code": "ERR_ENV_MISSING_VARIABLE_NAME"
# }
# ==============================================================================

# Public API Base URL for about-core backend (e.g. http://localhost:5000 or https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=

# Backend Secret for about-core protected endpoints (Authorization: Bearer <ADMIN_SECRET>)
ADMIN_SECRET=

# GitHub OAuth Application Client ID
GITHUB_CLIENT_ID=

# GitHub OAuth Application Client Secret
GITHUB_CLIENT_SECRET=

# Administrative Password for the Terminal Login Screen (verified with constant-time comparison)
ADMIN_PASSWORD=

# Cryptographic Secret for signing HTTP-only session cookies (HMAC-SHA256)
ADMIN_SESSION_SECRET=
